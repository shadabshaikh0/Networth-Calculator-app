# Copy this file to `keystore.properties` (which is gitignored) and fill in
# your real values. NEVER commit keystore.properties or the .jks file.
#
# Create the upload keystore first:
#   keytool -genkey -v -keystore upload-keystore.jks -alias upload \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Then `./gradlew :app:bundleRelease` produces a signed app-release.aab.

storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
